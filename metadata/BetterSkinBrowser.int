[BetterSkinBrowserMutator]
FriendlyName="Unreal Skin Browser"
Description="Adds a Skins tab to supported in-match ESC menus for browsing, previewing, and activating installed player skins with matching voices."

[SkinBrowserCreditsPage]
AlsoKnownAs="(aka CissiaLikesEggs)"
WindowName="Credits"
CreditsAuthor.Caption="Blue Natto"
CreditsRole.Caption="Creator of Unreal Skin Browser"
CreditsThanks.Caption="Thank you for your support!  \(^o^)/"
CreditsClose.Caption="Close"
CreditsClose.Hint="Return to Unreal Skin Browser."

